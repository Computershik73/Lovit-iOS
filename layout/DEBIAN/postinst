#!/bin/sh
#
# Что нужно сделать на самом устройстве после распаковки.
#
# До iOS 7 не требовалось ничего: SpringBoard сам обходил /Applications и
# запускал что найдёт. Дальше связку должен зарегистрировать LaunchServices,
# и без этого значок либо не появляется, либо появляется, но нажатие не даёт
# ничего — и в /var/mobile/Library/Logs/CrashReporter при этом пусто: падать
# нечему, процесс не заводят вовсе.
#
# Права выставляются ещё раз, хотя они правильные и в пакете: приложение могли
# ставить и распаковкой вручную, а связку с правами 777 система не примет.
set -e

APP=/Applications/Lovit.app

if [ -d "$APP" ]; then
	chown -R root:wheel "$APP" 2>/dev/null || true

	find "$APP" -type d -exec chmod 755 {} + 2>/dev/null || true
	find "$APP" -type f -exec chmod 644 {} + 2>/dev/null || true
	chmod 755 "$APP/Lovit" 2>/dev/null || true

	# Своя подпись у устройства бывает старее нашей и заведомо ему понятна.
	# Если ldid на устройстве нет — остаётся та, что приехала в пакете.
	if command -v ldid >/dev/null 2>&1; then
		ldid -S "$APP/Lovit" 2>/dev/null || true
	fi
fi

# Приложение звалось «Скам» и лежало в Scam.app. Смена имени сменила и путь,
# поэтому новая установка не заменяет старую: на экране остаются два значка,
# причём с одним и тем же идентификатором связки — LaunchServices от такого
# путается и запускает не то. При установке пакетом dpkg старое дерево уберёт
# сам, а вот при распаковке ipa вручную убирать некому.
#
# Проверка по идентификатору обязательна: удалять каталог по одному лишь имени,
# не убедившись, что он наш, нельзя.
OLD=/Applications/Scam.app

if [ -d "$OLD" ] && grep -q "ru.computershik.scam" "$OLD/Info.plist" 2>/dev/null; then
	rm -rf "$OLD"
fi

# uicache есть не везде и называется по-разному; молчаливый отказ здесь не
# страшен — значок появится после перезапуска SpringBoard.
if command -v uicache >/dev/null 2>&1; then
	uicache 2>/dev/null || uicache -a 2>/dev/null || true
fi

exit 0
